# --- Postgres (VPS 149.56.103.121, lorchidee_bookings database) -------------
# Analytics tables live in a new `analytics` schema inside this SAME database
# as the source `bookings` table, so ETL scripts use one connection for both.
PGHOST=149.56.103.121
PGPORT=5432
PGDATABASE=lorchidee_bookings
PGUSER=lorchidee_etl
PGPASSWORD=change-me

# Source table/schema for bookings (adjust if not in "public")
BOOKINGS_SCHEMA=public
BOOKINGS_TABLE=bookings

# --- Google APIs (service account) ------------------------------------------
# Path to the service-account JSON key. Share the Sheet with, and grant GA4 /
# Business Profile access to, this service account's client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json

# GA4
GA4_PROPERTY_ID=properties/XXXXXXXXX

# Google Business Profile
# Leave blank to auto-discover the first account/location the service account can see,
# or pin them explicitly (recommended once known, to avoid surprises if access changes).
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Google Sheets
GOOGLE_SHEET_ID=1_XO7x3aV4uTMf3cFVeVlMqcKhbwWvc8z0su9r6kih20
GOOGLE_SHEET_RANGE=Sheet1!A2:J

# --- Misc ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
# How many days back GA4/GBP pulls should re-fetch each run, to absorb late-arriving data
LOOKBACK_DAYS=3
